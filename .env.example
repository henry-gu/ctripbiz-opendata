# Server
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# CtripBiz Open API credentials
# You can also use the legacy names: Appkey, AppSecurity, Corpid, Uid.
CTRIPBIZ_BASE_URL=https://ct.ctrip.com
CTRIPBIZ_APP_KEY=your_ctripbiz_app_key
CTRIPBIZ_APP_SECURITY=your_ctripbiz_app_security
CTRIPBIZ_CORP_ID=your_ctripbiz_corp_id
CTRIPBIZ_UID=your_ctripbiz_uid
CTRIPBIZ_TIMEOUT_MS=15000

# OpenAI-compatible LLM service (used by the Smart Recommendation chatbot)
# BASE_URL must not include /chat/completions; the service appends it automatically.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_MODEL=your_model_name
OPENAI_TIMEOUT_MS=90000
